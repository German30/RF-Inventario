# Copiá este archivo como keystore.properties (en la raíz del repo) y completá
# los valores reales. keystore.properties NUNCA se commitea (está en
# .gitignore) — es lo único, junto con el .jks, que firma las actualizaciones
# de la app en los equipos del MDM. Ver docs/RELEASE.md.
storeFile=release-keystore.jks
storePassword=
keyAlias=rf-inventario
keyPassword=
